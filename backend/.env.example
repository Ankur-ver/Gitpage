NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/gitpage
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
OPENAI_API_KEY=sk-your-openai-api-key-here
REPOS_DIR=./repos

# AWS S3 repository object storage.
REPO_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for native AWS S3. Set this only for an S3-compatible provider.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
REPO_CACHE_DIR=